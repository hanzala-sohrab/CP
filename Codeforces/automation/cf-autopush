#!/usr/bin/env python3
"""Poll Codeforces for accepted submissions by HANDLE; commit+push the matching local file."""
import json, os, shutil, subprocess, sys, urllib.request

HANDLE = "hanzala"
REPO = "/home/hanzala/Code/CP/Codeforces"
STATE = os.path.expanduser("~/.local/state/cf-autopush/seen.json")
DRY = "--dry-run" in sys.argv
SLACK = 60  # seconds Solution.java may be newer than the submission
EXT = [("Java", "java", "Java"), ("C++", "cpp", "C++"), ("Py", "py", "Python"),
       ("Go", "go", "Go"), ("Kotlin", "kt", "Kotlin")]

def lang(name):
    for key, ext, label in EXT:
        if key in name:
            return ext, label
    return None, None

def git(*a):
    return subprocess.run(["git", "-C", REPO, *a], capture_output=True, text=True)

def save():
    if not DRY:
        json.dump(sorted(seen), open(STATE, "w"))

url = f"https://codeforces.com/api/user.status?handle={HANDLE}&from=1&count=50"
req = urllib.request.Request(url, headers={"User-Agent": "cf-autopush"})
data = json.load(urllib.request.urlopen(req, timeout=30))
if data.get("status") != "OK":
    sys.exit(f"API error: {data}")
ok = [s for s in data["result"] if s.get("verdict") == "OK"]

first_run = not os.path.exists(STATE)
seen = set() if first_run else set(json.load(open(STATE)))
if first_run:  # don't bulk-push history
    seen = {s["id"] for s in ok}
    save()
    print(f"bootstrapped {len(seen)} existing accepted submissions")
    sys.exit(0)

for s in sorted(ok, key=lambda s: s["id"]):
    if s["id"] in seen:
        continue
    p = s["problem"]
    pid = f'{p["contestId"]}{p["index"]}'
    ext, label = lang(s["programmingLanguage"])
    if not ext:
        print(f"{pid}: unsupported language {s['programmingLanguage']}")
        seen.add(s["id"]); continue
    fname = f"{pid}.{ext}"
    path = os.path.join(REPO, fname)
    if ext == "java" and not os.path.exists(path):
        src = os.path.join(REPO, "Solution.java")
        if not os.path.exists(src):
            print(f"{pid}: neither {fname} nor Solution.java found"); seen.add(s["id"]); continue
        if os.path.getmtime(src) > s["creationTimeSeconds"] + SLACK:
            print(f"{pid}: Solution.java modified after submission, skipping")
            seen.add(s["id"]); continue
        if not DRY:
            shutil.copyfile(src, path)
    elif not os.path.exists(path):
        print(f"{pid}: no local file {fname}, skipping")
        seen.add(s["id"]); continue
    tracked = git("ls-files", "--error-unmatch", fname).returncode == 0
    if tracked and not git("status", "--porcelain", "--", fname).stdout.strip():
        seen.add(s["id"]); continue
    msg = f'{"Update" if tracked else "Add"} solution for problem {pid} in {label}'
    print(msg)
    if not DRY:
        git("add", "--", fname)
        r = git("commit", "-m", msg, "--", fname)
        if r.returncode:
            print(r.stderr); continue
    seen.add(s["id"])
    save()

save()
if not DRY and git("rev-list", "--count", "@{u}..HEAD").stdout.strip() not in ("", "0"):
    r = git("push")
    if r.returncode:
        print(r.stderr)
